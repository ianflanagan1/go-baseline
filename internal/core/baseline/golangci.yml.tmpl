# Generated by go-baseline from go.mod. Don't edit: change the baseline, then
# run `go tool go-baseline write`.
version: "2"

linters:
  default: standard
  enable:
    - depguard
    - errorlint
    - exhaustive
    - forbidigo
    - gochecknoglobals
    - gochecknoinits
    - gochecksumtype
    - revive
    - testpackage
  settings:
    depguard:
      rules:
        # The functional core: pure functions over values. It imports only
        # other core packages, the standard library's pure packages and
        # third-party libraries.
        core:
          list-mode: lax
          files:
            - "**/internal/core/**"
            - "!$test"
          allow:
            - {{.Module}}/internal/core
            - net/mail
            - net/netip
            - net/url
          deny:
            - pkg: {{.Module}}
              desc: the core imports only the core
            - pkg: log
              desc: the core does no I/O
{{- range .IODenies}}
            - pkg: {{.}}
              desc: the core does no I/O
{{- end}}
        # The shell reaches outside dependencies only through ports, as
        # adapters that cmd/ wires in.
        shell:
          list-mode: lax
          files:
            - $all
            - "!$test"
            - "!**/cmd/**"
            - "!**/internal/adapters/**"
          allow:
            - net/mail
            - net/netip
            - net/url
          deny:
            - pkg: {{.Module}}/internal/adapters
              desc: reach adapters through their ports; wire them in cmd/
{{- range .IODenies}}
            - pkg: {{.}}
              desc: reach outside dependencies through ports
{{- end}}
    errorlint:
      errorf: true
      asserts: true
      comparison: true
    exhaustive:
      default-signifies-exhaustive: false
    forbidigo:
      analyze-types: true
      forbid:
        - pattern: ^time\.(Now|Since|Until|Sleep|After|AfterFunc|Tick|NewTimer|NewTicker)$
          msg: the clock is an adapter; take it through a port
    gochecksumtype:
      default-signifies-exhaustive: false
    revive:
      enable-default-rules: true
      rules:
        - name: exported
  exclusions:
    rules:
      - path: _test\.go
        linters:
          - forbidigo
      - path: (^|/)(cmd|internal/adapters)/
        linters:
          - forbidigo

formatters:
  enable:
    - gofmt
    - goimports
