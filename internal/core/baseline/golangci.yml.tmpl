# Generated by go-baseline from go.mod. Don't edit: change the baseline, then
# run `go tool go-baseline write`.
# Module kind: {{.Kind}}. Change it with `go tool go-baseline write -kind <kind>`.
version: "2"

run:
  # Lint the integration tests too.
  build-tags:
    - integration

linters:
  default: standard
  enable:
{{- if ne .Kind "adapters"}}
    - depguard
{{- end}}
    - errorlint
    - exhaustive
{{- if ne .Kind "adapters"}}
    - forbidigo
{{- end}}
    - funlen
    - gochecknoglobals
    - gochecknoinits
    - gochecksumtype
    - gocognit
    - gocyclo
    - revive
    - testpackage
  settings:
{{- if ne .Kind "adapters"}}
    depguard:
      rules:
{{- if eq .Kind "pure-library"}}
        # A pure library is all functional core: pure functions over values.
        # It imports only the standard library's pure packages and
        # third-party libraries.
        core:
          list-mode: lax
          files:
            - $all
            - "!$test"
          allow:
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
{{- template "coreDenies" .}}
{{- else}}
        # The functional core: pure functions over values. It imports only
        # other core packages, the standard library's pure packages and
        # third-party libraries.
        core:
          list-mode: lax
          files:
            - "**/internal/core/**"
            - "!$test"
          allow:
            - {{.Module}}/internal/core
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
            - pkg: {{.Module}}
              desc: the core imports only the core
{{- template "coreDenies" .}}
        # The shell reaches outside dependencies only through ports, as
        # adapters that cmd/ wires in.
        shell:
          list-mode: lax
          files:
            - $all
            - "!$test"
            - "!**/cmd/**"
            - "!**/adapters/**"
          allow:
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
            - pkg: {{.Module}}/internal/adapters
              desc: reach adapters through their ports; wire them in cmd/
{{- range .IOPackages}}
            - pkg: {{.}}
              desc: reach outside dependencies through ports
{{- end}}
        # Adapters translate between a port and the outside world. They may
        # use the core's types, but not the shell, so decisions stay out of
        # them.
        adapters:
          list-mode: lax
          files:
            - "**/adapters/**"
            - "!$test"
          allow:
            - {{.Module}}/internal/core
            - {{.Module}}/internal/adapters
            - {{.Module}}/adapters
          deny:
            - pkg: {{.Module}}
              desc: adapters don't call the shell; keep decisions out of them
{{- end}}
{{- end}}
    errorlint:
      errorf: true
      asserts: true
      comparison: true
    exhaustive:
      default-signifies-exhaustive: false
{{- if ne .Kind "adapters"}}
    forbidigo:
      analyze-types: true
      forbid:
        - pattern: ^time\.(Now|Since|Until|Sleep|After|AfterFunc|Tick|NewTimer|NewTicker)$
          msg: the clock is an adapter; take it through a port
        - pattern: ^(fmt\.Print(f|ln)?|print|println)$
          msg: printing is I/O; write through an io.Writer port
        - pattern: ^log\.(Print|Fatal|Panic)(f|ln)?$
          msg: the global logger is I/O; take a *slog.Logger
        - pattern: ^slog\.((Debug|Info|Warn|Error)(Context)?|Log|LogAttrs|Default|SetDefault)$
          msg: the global logger is I/O; take a *slog.Logger
{{- end}}
    funlen:
      lines: 50
      statements: 30
    gochecksumtype:
      default-signifies-exhaustive: false
    gocognit:
      min-complexity: 10
    gocyclo:
      min-complexity: 8
    revive:
      enable-default-rules: true
      rules:
        - name: exported
  exclusions:
    rules:
      - path: _test\.go
        linters:
          - forbidigo
          - funlen
          - gocognit
          - gocyclo
{{- if ne .Kind "adapters"}}
      - path: (^|/)(cmd|adapters)/
        linters:
          - forbidigo
      # Adapters and the composition root are kept thin and small; the core
      # and shell are limited by their own rules instead.
      - path-except: (^|/)(cmd|adapters)/
        linters:
          - funlen
      - path-except: (^|/)adapters/
        linters:
          - gocognit
          - gocyclo
{{- end}}

formatters:
  enable:
    - gofmt
    - goimports
{{- define "coreDenies"}}
            - pkg: context
              desc: the core takes values, not a context; I/O happens in the shell
            - pkg: log
              desc: the core does no I/O
{{- range .IOPackages}}
            - pkg: {{.}}
              desc: the core does no I/O
{{- end}}
{{- end}}
