# Generated by go-baseline from go.mod. Don't edit: change the baseline, then
# run `go tool go-baseline write`.
# Module kind: {{.Kind}}. Change it with `go tool go-baseline write -kind <kind>`.
version: "2"

run:
  # Lint the integration tests too.
  build-tags:
    - integration

linters:
  default: standard
  enable:
{{- if ne .Kind "adapters"}}
    - depguard
{{- end}}
    - errorlint
    - exhaustive
{{- if ne .Kind "adapters"}}
    - forbidigo
{{- end}}
    - funlen
    - gochecknoglobals
    - gochecknoinits
    - gochecksumtype
    - gocognit
    - gosec
    - modernize
    - revive
    - testpackage
    - wrapcheck
  settings:
{{- if ne .Kind "adapters"}}
    depguard:
      rules:
{{- if eq .Kind "pure-library"}}
        # A pure library is all functional core: pure functions over values.
        # It imports only the standard library's pure packages and
        # third-party libraries.
        core:
          list-mode: lax
          files:
            - $all
            - "!$test"
          allow:
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
{{- template "coreDenies" .}}
{{- else}}
        # The functional core: pure functions over values. It imports only
        # other core packages, the standard library's pure packages and
        # third-party libraries.
        core:
          list-mode: lax
          files:
            - "**/internal/core/**"
            - "!$test"
          allow:
            - {{.Module}}/internal/core
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
            - pkg: {{.Module}}
              desc: the core imports only the core
{{- template "coreDenies" .}}
        # Orchestrators reach outside dependencies only through the ports
        # they declare, which driven adapters implement and the entrypoint
        # in cmd/ passes in.
        orchestrators:
          list-mode: lax
          files:
            - $all
            - "!$test"
            - "!**/cmd/**"
            - "!**/adapters/**"
          allow:
{{- range .IOExceptions}}
            - {{.}}
{{- end}}
          deny:
            - pkg: {{.Module}}/internal/adapters
              desc: take driven adapters through the ports you declare; the entrypoint in cmd/ wires them in
{{- range .IOPackages}}
            - pkg: {{.}}
              desc: reach outside dependencies through ports
{{- end}}
        # Driving adapters turn calls from outside into calls to
        # orchestrators, which they import. They never reach a driven
        # adapter: every use case goes through an orchestrator.
        driving-adapters:
          list-mode: lax
          files:
            - "**/adapters/driving/**"
            - "!$test"
          deny:
            - pkg: {{.Module}}/internal/adapters/driven
              desc: a driving adapter reaches outside dependencies only by calling an orchestrator
        # Driven adapters implement the ports orchestrators declare. They may
        # use the core's types, but never an orchestrator or a driving
        # adapter, so decisions stay out of them.
        driven-adapters:
          list-mode: lax
          files:
            - "**/adapters/driven/**"
            - "!$test"
          allow:
            - {{.Module}}/internal/core
            - {{.Module}}/internal/adapters/driven
          deny:
            - pkg: {{.Module}}
              desc: a driven adapter imports only the core and other driven adapters; keep decisions out of it
{{- end}}
        # The entrypoint builds the adapters and passes them in by
        # hand, so the wiring is plain code that reads top to bottom.
        containers:
          list-mode: lax
          files:
            - $all
          deny:
{{- range .Containers}}
            - pkg: {{.}}
              desc: wire by hand in cmd/; construct each adapter and pass it in
{{- end}}
{{- end}}
    errorlint:
      errorf: true
      asserts: true
      comparison: true
    exhaustive:
      default-signifies-exhaustive: false
{{- if ne .Kind "adapters"}}
    forbidigo:
      analyze-types: true
      forbid:
        - pattern: ^time\.(Now|Since|Until|Sleep|After|AfterFunc|Tick|NewTimer|NewTicker)$
          msg: the clock is an adapter; take it through a port
        - pattern: ^(fmt\.Print(f|ln)?|print|println)$
          msg: printing is I/O; write through an io.Writer port
        - pattern: ^log\.(Print|Fatal|Panic)(f|ln)?$
          msg: the global logger is I/O; take a *slog.Logger
        - pattern: ^slog\.((Debug|Info|Warn|Error)(Context)?|Log|LogAttrs|Default|SetDefault)$
          msg: the global logger is I/O; take a *slog.Logger
{{- end}}
    funlen:
      lines: 50
      statements: 30
    gochecksumtype:
      default-signifies-exhaustive: false
    gocognit:
      min-complexity: 10
    govet:
      enable:
        - nilness
    revive:
      # modifies-parameter reports at confidence 0.5, below revive's default
      # threshold of 0.8.
      confidence: 0.5
      enable-default-rules: true
      rules:
        - name: exported
        # A parameter holds the argument it was given for the whole function.
        - name: modifies-parameter
    wrapcheck:
      # The module's own packages wrap their errors with context; wrap those
      # from other modules where they come in.
      ignore-package-globs:
        - {{.Module}}/*
  exclusions:
    rules:
      - path: _test\.go
        linters:
          - forbidigo
          - funlen
          - gocognit
          - gosec
          - wrapcheck
{{- if eq .Kind "adapters"}}
      # Running commands and opening files by name is what driven adapters
      # are for.
      - text: G204|G304
        linters:
          - gosec
{{- end}}
{{- if ne .Kind "adapters"}}
      - path: (^|/)(cmd|adapters)/
        linters:
          - forbidigo
      # Running commands and opening files by name is what adapters and
      # entrypoints are for.
      - path: (^|/)(cmd|adapters)/
        text: G204|G304
        linters:
          - gosec
      # Adapters and entrypoints are kept thin and small; the core and
      # orchestrators are limited by their own rules instead.
      - path-except: (^|/)(cmd|adapters)/
        linters:
          - funlen
{{- if eq .Kind "command"}}
      # The entrypoint is limited by funlen instead. Everywhere else
      # a function stays simple enough to review: decisions in the core are
      # split into named functions rather than nested.
      - path: (^|/)cmd/
        linters:
          - gocognit
{{- end}}
{{- end}}

formatters:
  enable:
    - gofumpt
    - goimports
{{- define "coreDenies"}}
            - pkg: context
              desc: the core takes values, not a context; I/O happens in adapters
            - pkg: log
              desc: the core does no I/O
{{- range .IOPackages}}
            - pkg: {{.}}
              desc: the core does no I/O
{{- end}}
{{- end}}
